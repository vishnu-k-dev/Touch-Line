DATABASE_URL=postgresql+psycopg://touchline:local_dev_password@localhost:5433/touchline

# AI analyst. Without a key every other endpoint still works; /api/v1/analyst/chat returns 503.
LLM_PROVIDER=openai          # openai | anthropic
LLM_API_KEY=                 # or set OPENAI_API_KEY / ANTHROPIC_API_KEY
LLM_MODEL=                   # empty = default (openai: gpt-5.6-luna, anthropic: claude-opus-5-5)
LLM_EFFORT=                  # empty = provider default (openai: none, anthropic: medium)

NEXT_PUBLIC_API_URL=http://localhost:8000
